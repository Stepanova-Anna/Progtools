@startuml Классы_на_русском
skinparam classAttributeIconSize 0
hide empty members

enum РольПользователя {
  СТУДЕНТ
  АДМИНИСТРАТОР
  КУРАТОР
}

enum СтатусМаршрута {
  ПОСТРОЕНИЕ
  ГОТОВ
  НАВИГАЦИЯ
  ЗАВЕРШЕН
  ОШИБКА
}

enum СтатусТочкиКвеста {
  ЗАБЛОКИРОВАНА
  ДОСТУПНА
  СКАНИРОВАНИЕ
  ГЕОПРОВЕРКА
  ОТВЕТ_НА_ВОПРОС
  ПРОЙДЕНА
  БЛОКИРОВКА_5_МИН
}

class Пользователь {
  - id: UUID
  - почта: string
  - ФИО: string
  - роль: РольПользователя
  - гостевойРежим: boolean
  + получитьПрофиль(): Профиль
}

class Профиль {
  - idПользователя: UUID
  - точкаСтарта: string
  - точкаНазначения: string
  - времяПостроенияМаршрута: Date
  - посещенныеТочки: ПосещениеТочки[]
  + сохранитьПосещение(в: ПосещениеТочки): void
}

class ПосещениеТочки {
  - idТочки: UUID
  - времяПосещения: Date
}

class КартаКампуса {
  - id: UUID
  - версия: string
  - датаОбновления: Date
  + найтиКорпус(запрос: string): Корпус[]
  + найтиАудиторию(номер: string): Аудитория
}

class Корпус {
  - id: UUID
  - название: string
  - адрес: string
  - координаты: ГеоТочка
}

class Аудитория {
  - id: UUID
  - номер: string
  - этаж: int
  - idКорпуса: UUID
}

class ГеоТочка {
  - широта: double
  - долгота: double
}

class Маршрут {
  - id: UUID
  - старт: ГеоТочка
  - финиш: ГеоТочка
  - расстояние: double
  - времяВПути: int
  - статус: СтатусМаршрута
  + построитьМаршрут(с: ГеоТочка, по: ГеоТочка): Маршрут
  + получитьШаги(): ШагМаршрута[]
}

class ШагМаршрута {
  - порядок: int
  - инструкция: string
}

class Ориентир {
  - тип: ТипОриентира
  - название: string
  - позиция: ГеоТочка
}

class СессияНавигации {
  - id: UUID
  - idМаршрута: UUID
  - времяСтарта: Date
  - позиция: ГеоТочка
  + обновитьПозицию(г: ГеоТочка): void
}

class КонтентУстава {
  - версия: string
  - хэш: string
  - датаОбновления: Date
  + актуален(): boolean
  + получитьОглавление(): Раздел[]
}

class Раздел {
  - id: UUID
  - заголовок: string
  - текст: string
}

class БазаЗнаний {
  + поиск(запрос: string): РезультатПоиска[]
}

class РезультатПоиска {
  - idСтатьи: UUID
  - фрагмент: string
  - релевантность: double
}

class МиниТест {
  - id: UUID
  - название: string
  + проверитьОтвет(idВопроса, вариант): boolean
}

class ВопросТеста {
  - id: UUID
  - текст: string
  - варианты: string[]
  - правильныйВариант: int
  - пояснение: string
}

class РезультатТеста {
  - id: UUID
  - баллы: int
  - датаПрохождения: Date
}

class Квест {
  - id: UUID
  - название: string
  - активен: boolean
}

class ТочкаКвеста {
  - id: UUID
  - название: string
  - позиция: ГеоТочка
  - нужнаГеопроверка: boolean
  - QRкод: string
  - статус: СтатусТочкиКвеста
}

class ПрогрессКвеста {
  - id: UUID
  - пройденныеТочки: UUID[]
  - ошибки: int
  + отметитьТочку(id: UUID): void
  + сохранитьЛокально(): void
  + синхронизировать(): Promise<void>
}

class Достижение {
  - id: UUID
  - название: string
  - описание: string
  - датаВыдачи: Date
}

class СервисПроверкиQR {
  + проверить(код: string, idТочки: UUID): boolean
}

class СервисУведомлений {
  + уведомитьАдмина(у: Уведомление): void
}

class Уведомление {
  - запрос: string
  - idПользователя: UUID
  - время: Date
  - версияКарты: string
}

Пользователь "1" --> "1" Профиль
Пользователь --> РольПользователя
КартаКампуса "1" *-- "many" Корпус
Корпус "1" *-- "many" Аудитория
Корпус --> ГеоТочка
Маршрут --> СтатусМаршрута
Маршрут "1" *-- "many" ШагМаршрута
ШагМаршрута --> Ориентир
СессияНавигации --> Маршрут
КонтентУстава "1" *-- "many" Раздел
БазаЗнаний ..> РезультатПоиска
МиниТест "1" *-- "many" ВопросТеста
РезультатТеста --> МиниТест
РезультатТеста --> Пользователь
Квест "1" *-- "many" ТочкаКвеста
ТочкаКвеста --> СтатусТочкиКвеста
ПрогрессКвеста --> Квест
ПрогрессКвеста --> Пользователь
ПрогрессКвеста --> ТочкаКвеста
Достижение --> Пользователь
@enduml
